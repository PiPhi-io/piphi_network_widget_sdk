{
  "name": "piphi-network-widget-sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for building declarative and sandboxed PiPhi dashboard widgets.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "bin",
    "simulator",
    "examples",
    "README.md",
    "RELEASING.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "piphi-widget": "./bin/piphi-widget.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./declarative": {
      "types": "./dist/declarative.d.ts",
      "import": "./dist/declarative.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "widget:create": "node bin/piphi-widget.mjs create",
    "widget:validate": "node bin/piphi-widget.mjs validate",
    "widget:conformance": "node scripts/verify-reference-widgets.mjs",
    "widget:dev": "node bin/piphi-widget.mjs dev",
    "widget:pack": "node bin/piphi-widget.mjs pack",
    "pilots:build": "node scripts/build-pilot-packages.mjs",
    "pilots:check": "node scripts/build-pilot-packages.mjs --check",
    "prepublishOnly": "npm run check && npm test && npm run widget:conformance && npm run build"
  },
  "keywords": [
    "piphi",
    "dashboard",
    "smart-home",
    "widget",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/PiPhi-io/piphi_network_widget_sdk#readme",
  "bugs": {
    "url": "https://github.com/PiPhi-io/piphi_network_widget_sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiPhi-io/piphi_network_widget_sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "PiPhi Network",
  "devDependencies": {
    "fflate": "0.8.3",
    "typescript": "~5.8.3"
  }
}
