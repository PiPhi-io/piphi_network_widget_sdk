{
  "name": "piphi-network-widget-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for building sandboxed PiPhi dashboard widgets.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "RELEASING.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "piphi",
    "dashboard",
    "smart-home",
    "widget",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/PiPhi-io/piphi_network_widget_sdk#readme",
  "bugs": {
    "url": "https://github.com/PiPhi-io/piphi_network_widget_sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PiPhi-io/piphi_network_widget_sdk.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "PiPhi Network",
  "devDependencies": {
    "typescript": "~5.8.3"
  }
}
