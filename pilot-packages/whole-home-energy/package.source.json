{
  "schema_version": "1",
  "identity": {"publisher_id": "io.piphi", "package_id": "whole-home-energy", "version": "0.1.2"},
  "name": "Whole Home Energy",
  "description": "A multi-source view of household demand, solar production, and battery state.",
  "origin": "standalone",
  "sdk_version_range": ">=0.6.1,<0.7",
  "recommended_for_integrations": ["piphi-network-sense", "piphi-network-solaredge"],
  "widgets": [{
    "id": "energy-overview",
    "name": "Whole Home Energy",
    "runtime": "declarative",
    "presentation": {"contract_version": "1", "shell": "core", "content_surface": "transparent", "typography": "core", "appearance_controls": ["icon", "title", "surface", "opacity", "radius", "shadow"]},
    "interaction_targets": [
      {"id": "energy-overview-card", "label": "Whole home energy", "kind": "card", "allowed_actions": ["more-info", "popout", "refresh"], "default_action": "more-info"}
    ],
    "certification": {
      "verified_gates": ["runtime", "persistence", "binding", "states", "responsive", "themes", "accessibility", "save-reload", "performance"],
      "evidence": {
        "runtime": ["core-profile:declarative-v2/runtime"],
        "persistence": ["core-profile:declarative-v2/persistence"],
        "binding": ["core-profile:declarative-v2/binding"],
        "states": ["core-profile:declarative-v2/states"],
        "responsive": ["core-profile:declarative-v2/responsive"],
        "themes": ["core-profile:declarative-v2/themes"],
        "accessibility": ["core-profile:declarative-v2/accessibility"],
        "save-reload": ["core-profile:declarative-v2/save-reload"],
        "performance": ["core-profile:declarative-v2/performance"]
      }
    },
    "binding_slots": [
      {"id": "consumption", "label": "Home consumption", "binding_modes": ["read"], "capability_requirements": ["active_power_w"], "compatible_integration_ids": ["piphi-network-sense"]},
      {"id": "solar", "label": "Solar production", "required": false, "binding_modes": ["read"], "capability_requirements": ["production_power_w"], "compatible_integration_ids": ["piphi-network-solaredge"]},
      {"id": "battery", "label": "Battery", "required": false, "binding_modes": ["read"], "capability_requirements": ["battery_soc_percent"], "compatible_integration_ids": ["piphi-network-solaredge"]}
    ],
    "recipe": {
      "schema_version": "1",
      "layout": "grid",
      "columns": 3,
      "items": [
        {"type": "metric", "slot_id": "consumption", "label": "Using now", "domain": "power", "emphasis": "hero"},
        {"type": "metric", "slot_id": "solar", "label": "Solar now", "domain": "energy"},
        {"type": "progress", "slot_id": "battery", "label": "Battery", "domain": "battery"}
      ]
    },
    "default_column_span": 6,
    "default_row_span": 3
  }]
}
