{
  "schema_version": "1",
  "identity": {"publisher_id": "io.piphi", "package_id": "home-health", "version": "0.1.2"},
  "name": "PiPhi Home Health",
  "description": "A first-party summary of connectivity and the lowest device battery.",
  "origin": "first_party",
  "sdk_version_range": ">=0.6.1,<0.7",
  "widgets": [{
    "id": "home-health",
    "name": "Home Health",
    "runtime": "declarative",
    "presentation": {"contract_version": "1", "shell": "core", "content_surface": "transparent", "typography": "core", "appearance_controls": ["icon", "title", "surface", "opacity", "radius", "shadow"]},
    "interaction_targets": [
      {"id": "home-health-card", "label": "Home health", "kind": "card", "allowed_actions": ["more-info", "popout", "refresh"], "default_action": "more-info"}
    ],
    "certification": {
      "verified_gates": ["runtime", "persistence", "binding", "states", "responsive", "themes", "accessibility", "save-reload", "performance"],
      "evidence": {
        "runtime": ["core-profile:declarative-v2/runtime"],
        "persistence": ["core-profile:declarative-v2/persistence"],
        "binding": ["core-profile:declarative-v2/binding"],
        "states": ["core-profile:declarative-v2/states"],
        "responsive": ["core-profile:declarative-v2/responsive"],
        "themes": ["core-profile:declarative-v2/themes"],
        "accessibility": ["core-profile:declarative-v2/accessibility"],
        "save-reload": ["core-profile:declarative-v2/save-reload"],
        "performance": ["core-profile:declarative-v2/performance"]
      }
    },
    "binding_slots": [
      {"id": "connectivity", "label": "Connectivity", "binding_modes": ["read"], "capability_requirements": ["connected"]},
      {"id": "battery", "label": "Lowest battery", "required": false, "binding_modes": ["read"], "capability_requirements": ["battery_percent"]}
    ],
    "recipe": {
      "schema_version": "1",
      "layout": "grid",
      "columns": 2,
      "items": [
        {"type": "status", "slot_id": "connectivity", "label": "Devices", "true_label": "Healthy", "false_label": "Needs attention", "domain": "connectivity"},
        {"type": "progress", "slot_id": "battery", "label": "Lowest battery", "domain": "battery"}
      ]
    },
    "default_column_span": 4,
    "default_row_span": 3
  }]
}
